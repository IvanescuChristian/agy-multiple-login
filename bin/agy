#!/usr/bin/env bash
# Shadows the real `agy` binary (this dir must sit ahead of it on PATH) to
# add a --login_new <profile> flag: runs that one invocation against an
# isolated HOME (agy keeps all state under $HOME/.gemini) so it gets its own saved login, separate from
# the shared $HOME/.gemini used by every other session/agent. The shared location is not used
# during a --login_new run (apart from the ~/.gitconfig and ~/.ssh
# symlinks, see README), so every other running (or future, flag-less) `agy` is
# unaffected.
#
# Usage:
#   agy --login_new work         # first time: creates+uses an isolated
#                                      # profile "work"; sign in once inside
#   agy --login_new work         # later: reuses that profile's login
#   agy --login_new              # no name: lists profiles
#   agy --login_new --list       # profiles + login status
#   agy --login_new --help       # wrapper-specific help
#   agy ...                      # no flag: exactly the real agy

set -euo pipefail

PROFILES_DIR="${AGY_LOGIN_NEW_PROFILES_DIR:-$HOME/.agy-profiles}"

find_real() {
  local self self_resolved
  self="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
  self_resolved="$(readlink -f "$self")"

  # install.sh records the real binary's path at install time.
  local real_bin_file recorded
  real_bin_file="$(dirname "$self")/.agy-real-bin"
  if [[ -f "$real_bin_file" ]]; then
    recorded="$(<"$real_bin_file")"
    if [[ -x "$recorded" && "$(readlink -f "$recorded" 2>/dev/null)" != "$self_resolved" ]]; then
      echo "$recorded"
      return 0
    fi
  fi

  local IFS=:
  local dir candidate
  for dir in $PATH; do
    candidate="$dir/agy"
    if [[ -x "$candidate" && "$(readlink -f "$candidate" 2>/dev/null)" != "$self_resolved" ]]; then
      echo "$candidate"
      return 0
    fi
  done
  unset IFS

  local fallback_globs=(
    "$HOME"/.nvm/versions/node/*/bin/agy
    "$HOME"/.local/share/pnpm/agy
    "$HOME"/.volta/bin/agy
    "$HOME"/.local/bin/agy
    /usr/local/bin/agy
    /usr/bin/agy
  )
  for candidate in "${fallback_globs[@]}"; do
    if [[ -x "$candidate" && "$(readlink -f "$candidate" 2>/dev/null)" != "$self_resolved" ]]; then
      echo "$candidate"
      return 0
    fi
  done
  return 1
}

# Resolved BEFORE any HOME override, and always to an absolute path.
REAL_BIN="$(find_real)" || {
  echo "agy wrapper: could not find the real agy binary on PATH (besides this wrapper)" >&2
  exit 1
}

show_profiles() {
  if [[ ! -d "$PROFILES_DIR" ]] || [[ -z "$(ls -A "$PROFILES_DIR" 2>/dev/null)" ]]; then
    echo "No profiles yet. Create one with: agy --login_new <name>"
    return
  fi
  echo "Profiles in $PROFILES_DIR:"
  local d name status
  for d in "$PROFILES_DIR"/*/; do
    [[ -d "$d" ]] || continue
    name="$(basename "$d")"
    status="not logged in"
    [[ -f "$d/.gemini/antigravity-cli/antigravity-oauth-token" ]] && status="logged in"
    printf '  %-20s %s\n' "$name" "$status"
  done
}

show_help() {
  cat <<HELP
agy --login_new <profile> [agy args...]
    Runs agy under an isolated profile (its own HOME, so its own .gemini/),
    without touching the shared $HOME/.gemini used by other sessions.
    First run: launch it with no other args and complete the Google sign-in inside, then verify with: agy --login_new <profile> models

agy --login_new --list
    Lists saved profiles under $PROFILES_DIR and their login status.

agy --login_new --help
    Shows this help.

Override the profile base directory with AGY_LOGIN_NEW_PROFILES_DIR.
All other agy flags/subcommands pass through untouched.
HELP
}

login_new=""
args=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --login_new|-login_new)
      if [[ $# -lt 2 || -z "$2" || ( "$2" == -* && "$2" != --list && "$2" != -list && "$2" != --help && "$2" != -help ) ]]; then
        show_profiles
        exit 0
      fi
      login_new="$2"
      shift 2
      ;;
    --login_new=*|-login_new=*)
      login_new="${1#*=}"
      shift
      ;;
    *)
      args+=("$1")
      shift
      ;;
  esac
done

case "$login_new" in
  --list|-list|list) show_profiles; exit 0 ;;
  --help|-help|help) show_help; exit 0 ;;
esac

if [[ -n "$login_new" ]]; then
  if [[ ! "$login_new" =~ ^[A-Za-z0-9._-]+$ ]]; then
    echo "agy: invalid profile name '$login_new' (use letters, numbers, ., _, -)" >&2
    exit 1
  fi
  profile_dir="$PROFILES_DIR/$login_new"
  mkdir -p "$profile_dir"
  # An explicit path is required: a relative PROFILES_DIR would break once the
  # child resolves it against its own cwd.
  profile_dir="$(cd "$profile_dir" && pwd)"
  # The profile HOME is empty, so tools the agent spawns (git, ssh) would lose
  # their config. Symlink (never copy, never overwrite) these from the real home.
  for item in .gitconfig .ssh; do
    if [[ -e "$HOME/$item" && ! -e "$profile_dir/$item" && ! -L "$profile_dir/$item" && "$HOME" != "$profile_dir" ]]; then
      ln -s "$HOME/$item" "$profile_dir/$item"
    fi
  done
  if [[ ! -f "$profile_dir/.gemini/antigravity-cli/antigravity-oauth-token" ]]; then
    echo "agy: profile '$login_new' has no saved login yet — launch it with no other args and complete the Google sign-in inside, then verify with: agy --login_new <profile> models (only this profile is affected)." >&2
  fi
  exec env HOME="$profile_dir" "$REAL_BIN" ${args[@]+"${args[@]}"}
else
  exec "$REAL_BIN" ${args[@]+"${args[@]}"}
fi
